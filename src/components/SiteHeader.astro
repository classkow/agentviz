---
interface Props {
	/** Header locale: picks the nav dictionary and the language-toggle target. Defaults to zh (existing behavior). */
	locale?: 'zh' | 'en';
}

const { locale = 'zh' } = Astro.props;

// BASE_URL has no trailing slash when `base` is configured without one.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The English site has its own homepage at /en/; pointing the brand and Home
// links at the root would drop English visitors onto the Chinese site.
const homeHref = locale === 'en' ? `${base}/en/` : `${base}/`;

const navItems =
	locale === 'en'
		? [
				// Only routes that actually exist in English.
				{ label: 'Home', href: homeHref },
				{ label: 'Courses', href: `${base}/en/learn/` },
				{ label: 'About', href: `${base}/en/about/` }
			]
		: [
				{ label: '首页', href: `${base}/` },
				{ label: '课程', href: `${base}/learn/` },
				{ label: '实验室', href: `${base}/lab/` },
				{ label: '参考库', href: `${base}/references/` },
				{ label: '关于', href: `${base}/about/` }
			];

// Match the current page against a nav item by comparing base-stripped,
// trailing-slash-normalized paths (home is '/').
const toPath = (href: string) => {
	const stripped = href.startsWith(base) ? href.slice(base.length) : href;
	if (stripped === '') return '/';
	return stripped.endsWith('/') ? stripped : `${stripped}/`;
};
const currentPath = toPath(Astro.url.pathname);
const isCurrent = (href: string) => toPath(href) === currentPath;

const menuLabel = locale === 'en' ? 'Open navigation menu' : '打开导航菜单';

// 站内搜索入口：Pagefind UI 首次打开时才加载，页面自身不带搜索运行时。
const searchCopy =
	locale === 'en'
		? { label: 'Search', aria: 'Search the whole site', dialog: 'Site search' }
		: { label: '搜索', aria: '站内搜索', dialog: '站内搜索' };

// 语言切换链接：剥掉 base 前缀后按路径换算对方语言的对应页；
// 没有对方语言版本的页面（lab/references）一律切到对方首页。
const rawPath = Astro.url.pathname.startsWith(base)
	? Astro.url.pathname.slice(base.length) || '/'
	: Astro.url.pathname;

let switchHref: string;
let switchLabel: string;
let switchAria: string;
// Routes that exist in both languages switch in place; everything else (lab,
// references) falls back to the other language's homepage.
const hasCounterpart = (path: string) => path === '/' || path.startsWith('/learn/') || path === '/about/';
if (locale === 'zh') {
	switchLabel = 'EN';
	switchAria = 'Switch to English';
	switchHref = hasCounterpart(rawPath) ? `${base}/en${rawPath}` : `${base}/en/`;
} else {
	switchLabel = '中文';
	switchAria = '切换到中文';
	switchHref = rawPath.startsWith('/en/') ? `${base}${rawPath.slice(3) || '/'}` : `${base}/`;
}
const switchClass =
	'rounded-md border border-zinc-700 px-2 py-1 text-xs text-zinc-400 transition-colors hover:border-zinc-500 hover:text-zinc-100';
---

<header class="sticky top-0 z-50 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur">
	<div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6">
		<a
			href={homeHref}
			class="bg-gradient-to-r from-sky-400 to-violet-500 bg-clip-text text-xl font-bold tracking-tight text-transparent"
		>
			AgentViz
		</a>

		<div class="flex items-center gap-4">
			<nav class="hidden items-center gap-6 md:flex">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
							class:list={[
								'text-sm transition-colors hover:text-zinc-100',
								isCurrent(item.href) ? 'text-zinc-100' : 'text-zinc-400'
							]}
						>
							{item.label}
						</a>
					))
				}
			</nav>

			<button
				type="button"
				id="site-search-open"
				aria-label={searchCopy.aria}
				class="flex items-center gap-1.5 rounded-md border border-zinc-700 px-2 py-1.5 text-xs text-zinc-400 transition-colors hover:border-zinc-500 hover:text-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
			>
				<svg
					class="h-4 w-4"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.75"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
					></path>
				</svg>
				{searchCopy.label}
			</button>

			<a href={switchHref} aria-label={switchAria} class={switchClass}>
				{switchLabel}
			</a>

			<details class="group relative md:hidden">
				<summary
					class="flex cursor-pointer list-none items-center justify-center rounded-lg p-2 text-zinc-400 transition-colors hover:text-zinc-100 [&::-webkit-details-marker]:hidden"
					aria-label={menuLabel}
				>
					<svg
						class="h-6 w-6 group-open:hidden"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
					</svg>
					<svg
						class="hidden h-6 w-6 group-open:block"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
					</svg>
				</summary>
				<nav
					class="absolute right-0 mt-2 flex w-40 flex-col rounded-xl border border-zinc-800 bg-zinc-900 p-2 shadow-lg"
				>
					{
						navItems.map((item) => (
							<a
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
								class:list={[
									'rounded-lg px-3 py-2 text-sm transition-colors hover:bg-zinc-800 hover:text-zinc-100',
									isCurrent(item.href) ? 'text-zinc-100' : 'text-zinc-400'
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>
			</details>
		</div>
	</div>
</header>

<dialog
	id="site-search-dialog"
	aria-label={searchCopy.dialog}
	class="w-[min(92vw,36rem)] rounded-2xl border border-zinc-800 bg-zinc-950 p-4 text-zinc-100 backdrop:bg-zinc-950/70"
>
	<div class="mb-3 flex items-center justify-between gap-3">
		<h2 class="text-sm font-semibold text-zinc-300">{searchCopy.dialog}</h2>
		<button
			type="button"
			id="site-search-close"
			class="rounded-md border border-zinc-700 px-2 py-1.5 text-xs text-zinc-400 transition-colors hover:border-zinc-500 hover:text-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
		>
			{locale === 'en' ? 'Close' : '关闭'}
		</button>
	</div>
	<div
		class="pagefind-mount"
		style="--pagefind-ui-scale:0.95;--pagefind-ui-font:inherit;--pagefind-ui-primary:#38bdf8;--pagefind-ui-text:#e4e4e7;--pagefind-ui-background:#09090b;--pagefind-ui-border:#27272a;--pagefind-ui-tag:#18181b;--pagefind-ui-border-radius:0.5rem;"
	></div>
</dialog>

<script>
	// Pagefind's UI bundle ships alongside the index at <base>/pagefind/. It is
	// fetched on the first opening of the dialog only, so no page pays for it
	// up front. The bundle exposes a global PagefindUI constructor.
	type PagefindUIInit = {
		element: Element;
		bundlePath?: string;
		showImages?: boolean;
	};
	type PagefindUICtor = new (init: PagefindUIInit) => { triggerSearch(): void };

	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	const dialog = document.getElementById('site-search-dialog') as HTMLDialogElement | null;
	const mount = dialog?.querySelector<Element>('.pagefind-mount') ?? null;

	let loading: Promise<PagefindUICtor | null> | null = null;
	let instance: { triggerSearch(): void } | null = null;

	function loadUI(): Promise<PagefindUICtor | null> {
		if (loading) return loading;
		loading = new Promise((resolve, reject) => {
			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = `${base}/pagefind/pagefind-ui.css`;
			const js = document.createElement('script');
			js.src = `${base}/pagefind/pagefind-ui.js`;
			js.addEventListener('load', () => {
				const ctor = (window as unknown as { PagefindUI?: PagefindUICtor }).PagefindUI ?? null;
				if (ctor) resolve(ctor);
				else reject(new Error('PagefindUI 未导出'));
			});
			js.addEventListener('error', () => reject(new Error('Pagefind UI 资源加载失败')));
			document.head.append(css, js);
		});
		return loading;
	}

	async function openSearch() {
		if (!dialog || !mount) return;
		dialog.showModal();
		try {
			const ctor = await loadUI();
			if (!ctor) return;
			if (!instance) {
				instance = new ctor({ element: mount, bundlePath: `${base}/pagefind/`, showImages: false });
			}
			const input = mount.querySelector<HTMLInputElement>(
				'.pagefind-ui__search-input, input[type="search"]'
			);
			input?.focus();
			if (input?.value) instance.triggerSearch();
		} catch {
			// 索引缺失（例如尚未 build 就直接 preview）时，弹窗保持空白而不报错。
		}
	}

	document.getElementById('site-search-open')?.addEventListener('click', () => void openSearch());
	document.getElementById('site-search-close')?.addEventListener('click', () => dialog?.close());
</script>
