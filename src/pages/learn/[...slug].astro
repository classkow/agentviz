---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import LearnShell from '../../layouts/LearnShell.astro';

export async function getStaticPaths() {
	const lessons = await getCollection('lessons');
	return lessons.map((lesson) => ({
		params: { slug: lesson.id },
		props: { lesson }
	}));
}

interface Props {
	lesson: CollectionEntry<'lessons'>;
}

const { lesson } = Astro.props;
const {
	title,
	description,
	module: moduleKey,
	sources,
	reviewed_at: reviewedAt,
	draft
} = lesson.data;

const moduleNames: Record<typeof moduleKey, string> = {
	E: '地基',
	P: 'Prompt 工程',
	T: 'Tool Calling',
	R: 'RAG',
	A: 'Agent',
	G: '上线工程化'
};

// 站内内链必须带 base（/agentviz）前缀
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(lesson);
---

<LearnShell title={title} description={description}>
	<article>
		<nav class="text-sm text-zinc-400">
			<a href={`${base}/learn/`} class="hover:text-zinc-100">← 全部课程</a>
		</nav>

		<header class="mt-6 border-b border-zinc-800 pb-6">
			<div class="flex flex-wrap items-center gap-3">
				<span
					class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold tracking-wide text-zinc-300"
				>
					模块 {moduleKey} · {moduleNames[moduleKey]}
				</span>
				{
					draft && (
						<span class="rounded-full border border-zinc-700 px-3 py-1 text-xs text-zinc-500">
							草稿 · 即将到来
						</span>
					)
				}
			</div>
			<h1 class="mt-4 text-3xl font-bold tracking-tight">{title}</h1>
			<p class="mt-3 text-sm leading-relaxed text-zinc-400">{description}</p>
			<p class="mt-4 text-xs text-zinc-500">最后审校：{reviewedAt.toISOString().slice(0, 10)}</p>
		</header>

		<div class="lesson-body mt-8">
			<Content />
		</div>

		<footer class="mt-12 border-t border-zinc-800 pt-6">
			<h2 class="text-sm font-semibold tracking-wide text-zinc-400 uppercase">
				官方来源（{sources.length}）
			</h2>
			<ul class="mt-3 flex flex-col gap-2">
				{
					sources.map((url) => (
						<li class="break-all text-sm">
							<a
								href={url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-sky-400 hover:underline"
							>
								{url}
							</a>
						</li>
					))
				}
			</ul>
		</footer>
	</article>
</LearnShell>

<style is:global>
	.lesson-body h2 {
		margin-top: 2.5rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-zinc-100, #f4f4f5);
	}

	.lesson-body p {
		margin-top: 0.75rem;
		line-height: 1.75;
		color: var(--color-zinc-300, #d4d4d8);
	}

	.lesson-body blockquote {
		margin-top: 1.5rem;
		border-left: 2px solid #3f3f46;
		padding-left: 1rem;
		color: #a1a1aa;
	}

	.lesson-body ul {
		margin-top: 0.75rem;
		padding-left: 1.25rem;
		list-style: disc;
		line-height: 1.75;
		color: #d4d4d8;
	}

	.lesson-body code {
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		background-color: #27272a;
		font-size: 0.875em;
	}
</style>
