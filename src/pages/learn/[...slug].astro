---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SwimlaneTimeline from '../../components/SwimlaneTimeline.vue';
import type { TimelineDemo } from '../../components/SwimlaneTimeline.vue';
import SamplingLab from '../../components/SamplingLab.vue';
import type { DemoData } from '../../components/SamplingLab.vue';

export async function getStaticPaths() {
	const lessons = await getCollection('lessons');
	return lessons.map((lesson) => ({
		params: { slug: lesson.id },
		props: { lesson }
	}));
}

const { lesson } = Astro.props;
const {
	title,
	description,
	module: moduleKey,
	sources,
	reviewed_at: reviewedAt,
	draft,
	demo,
	component
} = lesson.data;

// 演示槽组件注册表：键名对应 frontmatter 的 component 字段，新演示组件在此登记。
// client:* 注水指令的模板标签必须是静态导入的组件标识符本身——实测 Astro 7.3 里
// 经注册表变量/别名转发会被 NoMatchingImport 构建期硬拒（import.meta.glob 动态挂
// 组件同理），因此渲染处按 demoComponentKey 条件分支、直接引用下面两个静态导入。
const COMPONENTS = {
	swimlane: SwimlaneTimeline,
	sampling: SamplingLab
} as const;
type DemoComponentKey = keyof typeof COMPONENTS;
const requestedKey = component ?? 'swimlane';
const demoComponentKey: DemoComponentKey =
	requestedKey in COMPONENTS ? (requestedKey as DemoComponentKey) : 'swimlane';

const moduleNames: Record<typeof moduleKey, string> = {
	E: '地基',
	P: 'Prompt 工程',
	T: 'Tool Calling',
	R: 'RAG',
	A: 'Agent',
	G: '上线工程化'
};

// 站内内链必须带 base（/agentviz）前缀
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(lesson);

// 演示数据按 frontmatter 的 demo 字段条件加载；组件必须静态导入，
// import.meta.glob 只用于 JSON 数据（client:* 注水指令不认动态导入的组件绑定）
const demoModules = import.meta.glob('../../demos/*.json');
// 两个演示组件各自定义 demo prop 类型；JSON 反序列化后只有 unknown 形状，
// 与任一组件的类型都互不相交，这里用 as unknown as 桥接为「两类型交集」——
// 交集可同时赋给任一组件的 demo prop（运行时实际形状由 demo 字段与对应 JSON 的约定保证）。
type AnyDemoData = TimelineDemo & DemoData;
let demoData: AnyDemoData | null = null;
if (demo) {
	const loadDemo = demoModules[`../../demos/${demo}.json`];
	if (loadDemo) {
		const mod = (await loadDemo()) as { default: unknown };
		demoData = mod.default as unknown as AnyDemoData;
	}
}
---

<Base title={title} description={description}>
	<article>
		<nav class="text-sm text-zinc-400">
			<a href={`${base}/learn/`} class="hover:text-zinc-100">← 全部课程</a>
		</nav>

		<header class="mt-6 border-b border-zinc-800 pb-6">
			<div class="flex flex-wrap items-center gap-3">
				<span
					class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold tracking-wide text-zinc-300"
				>
					模块 {moduleKey} · {moduleNames[moduleKey]}
				</span>
				{
					draft && (
						<span class="rounded-full border border-zinc-700 px-3 py-1 text-xs text-zinc-500">
							草稿 · 即将到来
						</span>
					)
				}
			</div>
			<h1 class="mt-4 text-3xl font-bold tracking-tight">{title}</h1>
			<p class="mt-3 text-sm leading-relaxed text-zinc-400">{description}</p>
			<p class="mt-4 text-xs text-zinc-500">最后审校：{reviewedAt.toISOString().slice(0, 10)}</p>
		</header>

		{demoData && demoComponentKey === 'sampling' && <SamplingLab client:visible demo={demoData} />}
		{demoData && demoComponentKey === 'swimlane' && (
			<SwimlaneTimeline client:visible demo={demoData} />
		)}

		<div class="lesson-body mt-8">
			<Content />
		</div>

		<footer class="mt-12 border-t border-zinc-800 pt-6">
			<h2 class="text-sm font-semibold tracking-wide text-zinc-400 uppercase">
				官方来源（{sources.length}）
			</h2>
			<ul class="mt-3 flex flex-col gap-2">
				{
					sources.map((url) => (
						<li class="break-all text-sm">
							<a
								href={url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-sky-400 hover:underline"
							>
								{url}
							</a>
						</li>
					))
				}
			</ul>
		</footer>
	</article>
</Base>

<style is:global>
	.lesson-body h2 {
		margin-top: 2.5rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-zinc-100, #f4f4f5);
	}

	.lesson-body p {
		margin-top: 0.75rem;
		line-height: 1.75;
		color: var(--color-zinc-300, #d4d4d8);
	}

	.lesson-body blockquote {
		margin-top: 1.5rem;
		border-left: 2px solid #3f3f46;
		padding-left: 1rem;
		color: #a1a1aa;
	}

	.lesson-body ul {
		margin-top: 0.75rem;
		padding-left: 1.25rem;
		list-style: disc;
		line-height: 1.75;
		color: #d4d4d8;
	}

	.lesson-body code {
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		background-color: #27272a;
		font-size: 0.875em;
	}
</style>
