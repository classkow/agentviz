---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SwimlaneTimeline from '../../components/SwimlaneTimeline.vue';
import type { TimelineDemo } from '../../components/SwimlaneTimeline.vue';
import SamplingLab from '../../components/SamplingLab.vue';
import type { DemoData } from '../../components/SamplingLab.vue';
import TokenCounter from '../../components/TokenCounter.vue';
import type { TokenDemo } from '../../components/TokenCounter.vue';
import QuizBlock from '../../components/QuizBlock.vue';
import type { QuizData } from '../../components/QuizBlock.vue';
// 来源可读名表全站共用（课页 + 参考库聚合页），未收录域名回退显示域名本身。
import { sourceName } from '../../lib/source-names';
import { isoDay, reviewStatus } from '../../lib/review-status';
import { prepareLessonBody } from '../../lib/lesson-body';

export async function getStaticPaths() {
	const lessons = await getCollection('lessons');
	return lessons.map((lesson) => ({
		params: { slug: lesson.id },
		props: { lesson }
	}));
}

const { lesson } = Astro.props;
const {
	title,
	description,
	module: moduleKey,
	sources,
	reviewed_at: reviewedAt,
	draft,
	demo,
	component,
	readingMinutes,
	level
} = lesson.data;

// 演示槽组件注册表：键名对应 frontmatter 的 component 字段，新演示组件在此登记。
// client:* 注水指令的模板标签必须是静态导入的组件标识符本身——实测 Astro 7.3 里
// 经注册表变量/别名转发会被 NoMatchingImport 构建期硬拒（import.meta.glob 动态挂
// 组件同理），因此渲染处按 demoComponentKey 条件分支、直接引用上面的静态导入。
const COMPONENTS = {
	swimlane: SwimlaneTimeline,
	sampling: SamplingLab,
	token: TokenCounter
} as const;
type DemoComponentKey = keyof typeof COMPONENTS;
const requestedKey = component ?? 'swimlane';
const demoComponentKey: DemoComponentKey =
	requestedKey in COMPONENTS ? (requestedKey as DemoComponentKey) : 'swimlane';

const moduleNames: Record<typeof moduleKey, string> = {
	E: '地基',
	P: 'Prompt 工程',
	T: 'Tool Calling',
	R: 'RAG',
	A: 'Agent',
	G: '上线工程化'
};

// 难度标签：readingMinutes 与 level 都是可选字段，缺失时对应片段整段不渲染。
const levelLabels: Record<NonNullable<typeof level>, string> = {
	intro: '入门',
	intermediate: '进阶',
	practice: '实战'
};

const reviewedDay = isoDay(reviewedAt);
// 复审节奏在构建期算死：静态站上没有运行时时钟可看。
const review = reviewStatus(reviewedAt);

const metaParts: string[] = [];
if (readingMinutes) metaParts.push(`约 ${readingMinutes} 分钟`);
if (level) metaParts.push(levelLabels[level]);
metaParts.push(`最后审校：${reviewedDay}`);

// 站内内链必须带 base（/agentviz）前缀
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 自测题插进正文中段，所以正文按渲染产物（lesson.rendered.html）处理：先给正文里的
// 站内链接补 base 前缀，再切成「主体 + 演示数据说明」两段，QuizBlock 夹在中间——
// 顺序即「带走三句话之后、演示数据说明之前」。
const { main: bodyMain, note: bodyNote } = prepareLessonBody(lesson.rendered?.html ?? '', base);

// 演示数据按 frontmatter 的 demo 字段条件加载；组件必须静态导入，
// import.meta.glob 只用于 JSON 数据（client:* 注水指令不认动态导入的组件绑定）
const demoModules = import.meta.glob('../../demos/*.json');
// 三个演示组件各自定义 demo prop 类型；JSON 反序列化后只有 unknown 形状，
// 与任一组件的类型都互不相交，这里用 as unknown as 桥接为「三类型交集」——
// 交集可同时赋给任一组件的 demo prop（运行时实际形状由 demo 字段与对应 JSON 的约定保证）。
type AnyDemoData = TimelineDemo & DemoData & TokenDemo;
let demoData: AnyDemoData | null = null;
if (demo) {
	const loadDemo = demoModules[`../../demos/${demo}.json`];
	if (loadDemo) {
		const mod = (await loadDemo()) as { default: unknown };
		demoData = mod.default as unknown as AnyDemoData;
	}
}

// 自测题数据 glob 只用于 JSON（同演示数据的约束）；没有对应文件的课不渲染自测。
const quizModules = import.meta.glob('../../content/quizzes/*.json');
const loadQuiz = quizModules[`../../content/quizzes/${lesson.id}.json`];
const quizData: QuizData | null = loadQuiz
	? ((await loadQuiz()) as { default: QuizData }).default
	: null;

// 同模块内的上一课 / 下一课：按 frontmatter 的 order 排序取相邻课。
const moduleLessons = (await getCollection('lessons'))
	.filter((entry) => entry.data.module === moduleKey)
	.sort((a, b) => a.data.order - b.data.order);
const lessonIndex = moduleLessons.findIndex((entry) => entry.id === lesson.id);
const prevLesson = lessonIndex > 0 ? moduleLessons[lessonIndex - 1] : null;
const nextLesson =
	lessonIndex >= 0 && lessonIndex < moduleLessons.length - 1
		? moduleLessons[lessonIndex + 1]
		: null;
---

<Base title={title} description={description}>
	<article>
		<nav aria-label="课程索引" class="text-sm text-zinc-400">
			<a href={`${base}/learn/`} class="hover:text-zinc-100">← 全部课程</a>
		</nav>

		<header class="mt-6 border-b border-zinc-800 pb-6">
			<div class="flex flex-wrap items-center gap-3">
				<span
					class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold tracking-wide text-zinc-300"
				>
					模块 {moduleKey} · {moduleNames[moduleKey]}
				</span>
				{
					draft && (
						<span class="rounded-full border border-zinc-700 px-3 py-1 text-xs text-zinc-500">
							草稿 · 即将到来
						</span>
					)
				}
			</div>
			<h1 class="mt-4 text-3xl font-bold tracking-tight">{title}</h1>
			<p class="mt-3 text-sm leading-relaxed text-zinc-400">{description}</p>
			<p class="mt-4 text-xs text-zinc-400">
				{metaParts.join(' · ')}
				{review.stale && <span class="ml-2 font-medium text-amber-400">· 建议复审</span>}
			</p>
		</header>

		{
			demoData && (
				<div id="lesson-demo">
					{demoComponentKey === 'sampling' && <SamplingLab client:visible demo={demoData} />}
					{demoComponentKey === 'token' && <TokenCounter client:visible demo={demoData} />}
					{demoComponentKey === 'swimlane' && <SwimlaneTimeline client:visible demo={demoData} />}
				</div>
			)
		}

		<div class="lesson-body mt-8">
			<div set:html={bodyMain} />
			{quizData && <QuizBlock client:load quiz={quizData} />}
			{bodyNote && <div set:html={bodyNote} />}
		</div>

		<footer class="mt-12 border-t border-zinc-800 pt-6">
			<h2 class="text-sm font-semibold tracking-wide text-zinc-400 uppercase">
				官方来源（{sources.length}）
				<span class="ml-1 normal-case tracking-normal text-zinc-500">· 来源核验于 {reviewedDay}</span>
			</h2>
			<ul class="mt-3 flex flex-col gap-2">
				{
					sources.map((url) => (
						<li class="break-all text-sm">
							<a
								href={url}
								target="_blank"
								rel="noopener noreferrer"
								class="hover:underline"
							>
								<span class="font-medium text-zinc-100">{sourceName(url)}</span>
								<span class="text-zinc-500"> — </span>
								<span class="font-mono text-xs text-sky-400">{url}</span>
							</a>
						</li>
					))
				}
			</ul>
		</footer>

		<nav
			aria-label="课程导航"
			class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-zinc-800 pt-6 text-sm sm:flex-row sm:gap-6"
		>
			{
				prevLesson ? (
					<a
						href={`${base}/learn/${prevLesson.id}/`}
						class="text-sky-400 transition-colors hover:text-sky-300"
					>
						← 上一课：{prevLesson.data.title}
					</a>
				) : (
					<span class="text-zinc-500">本模块第一课</span>
				)
			}
			<span class="shrink-0 text-zinc-400">
				模块 {moduleKey} · 第 {lessonIndex + 1}/{moduleLessons.length} 课
			</span>
			{
				nextLesson ? (
					<a
						href={`${base}/learn/${nextLesson.id}/`}
						class="text-sky-400 transition-colors hover:text-sky-300"
					>
						下一课：{nextLesson.data.title} →
					</a>
				) : (
					<span class="text-zinc-500">本模块最后一课</span>
				)
			}
		</nav>

		<div class="mt-6 flex justify-center">
			<button
				type="button"
				hidden
				aria-pressed="false"
				data-read-toggle={lesson.id}
				data-label-unread="标记为已读"
				data-label-read="✓ 已读（点击取消）"
				class="rounded-full border border-zinc-700 bg-zinc-900 px-4 py-1.5 text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100 aria-pressed:border-emerald-400/60 aria-pressed:bg-emerald-400/10 aria-pressed:text-emerald-200"
			></button>
		</div>
	</article>
</Base>

<script>
	import { initReadProgress } from '../../lib/read-progress';

	initReadProgress();
</script>

<style is:global>
	/* 正文行长约束：72ch 便于扫读；演示区在 .lesson-body 之外，保持全宽。 */
	.lesson-body {
		max-width: 72ch;
		margin-inline: auto;
	}

	.lesson-body h2 {
		margin-top: 2.5rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-zinc-100, #f4f4f5);
	}

	.lesson-body p {
		margin-top: 0.75rem;
		line-height: 1.75;
		color: var(--color-zinc-300, #d4d4d8);
	}

	.lesson-body blockquote {
		margin-top: 1.5rem;
		border-left: 2px solid #3f3f46;
		padding-left: 1rem;
		color: #a1a1aa;
	}

	.lesson-body ul {
		margin-top: 0.75rem;
		padding-left: 1.25rem;
		list-style: disc;
		line-height: 1.75;
		color: #d4d4d8;
	}

	.lesson-body code {
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		background-color: #27272a;
		font-size: 0.875em;
	}

	/* Tailwind preflight 把 a 重置成 color:inherit，正文里的「回看演示第 N 步」
	   这类内链需要自己的可点击外观。 */
	.lesson-body a {
		color: var(--color-sky-400, #38bdf8);
		text-decoration: none;
	}

	.lesson-body a:hover {
		text-decoration: underline;
	}

	.lesson-body pre {
		margin-top: 1.25rem;
		overflow-x: auto;
		border: 1px solid #27272a;
		border-radius: 0.5rem;
		padding: 1rem;
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	.lesson-body pre code {
		padding: 0;
		background-color: transparent;
	}
</style>
