---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import LearnShell from '../../layouts/LearnShell.astro';

type Lesson = CollectionEntry<'lessons'>;
type ModuleKey = Lesson['data']['module'];

const moduleLabels: Record<ModuleKey, string> = {
	E: '地基：和 LLM 对话的最小知识',
	P: 'Prompt 工程：把需求说清楚',
	T: 'Tool Calling：模型的手',
	R: 'RAG：给模型开卷考试',
	A: 'Agent：会自己干活的模型',
	G: '上线工程化'
};

// 站内内链必须带 base（/agentviz）前缀
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formatDate = (date: Date) => date.toISOString().slice(0, 10);

const lessons = await getCollection('lessons');
const groups = (Object.keys(moduleLabels) as ModuleKey[])
	.map((key) => ({
		key,
		label: moduleLabels[key],
		items: lessons
			.filter((lesson) => lesson.data.module === key)
			.sort((a, b) => a.data.order - b.data.order)
	}))
	.filter((group) => group.items.length > 0);
---

<LearnShell title="课程" description="AgentViz 课程索引：按模块列出全部课程与官方来源。">
	<h1 class="text-3xl font-bold tracking-tight">课程</h1>
	<p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
		每课 = 正文 + 交互演示，并强制绑定官方来源与最后审校日期。标注「即将到来」的条目为已排期草稿。
	</p>

	<div class="mt-10 flex flex-col gap-12">
		{
			groups.map((group) => (
				<section aria-labelledby={`module-${group.key}`}>
					<h2
						id={`module-${group.key}`}
						class="text-sm font-semibold tracking-wide text-zinc-400 uppercase"
					>
						模块 {group.key} · {group.label}
					</h2>
					<ul class="mt-4 flex flex-col gap-4">
						{group.items.map((lesson: Lesson) => {
							const href = `${base}/learn/${lesson.id}/`;
							const { title, description, sources, reviewed_at, draft } = lesson.data;
							return (
								<li class="rounded-xl border border-zinc-800 bg-zinc-900/40">
									<a
										href={href}
										class:list={[
											'block p-5 transition-colors',
											draft
												? 'cursor-default text-zinc-500'
												: 'text-zinc-100 hover:bg-zinc-900'
										]}
									>
										<div class="flex flex-wrap items-center gap-3">
											<h3 class="text-lg font-semibold">{title}</h3>
											{draft && (
												<span class="rounded-full border border-zinc-700 px-2 py-0.5 text-xs text-zinc-500">
													即将到来
												</span>
											)}
										</div>
										<p class="mt-2 text-sm leading-relaxed text-zinc-400">
											{description}
										</p>
										<p class="mt-3 text-xs text-zinc-500">
											来源 {sources.length} 条 · 审校于 {formatDate(reviewed_at)}
										</p>
									</a>
								</li>
							);
						})}
					</ul>
				</section>
			))
		}
	</div>
</LearnShell>
