---
import Base from '../../layouts/Base.astro';
import CourseMap from '../../components/CourseMap.vue';

// Locale prefix configured via `i18n.routing.prefixDefaultLocale: false` in
// astro.config.mjs — English lives under /en/, default (zh) lives at the root.
// In-site links must still carry the GitHub Pages `base` prefix.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
	<section class="flex flex-col items-center gap-6 py-16 text-center sm:py-24">
		<h1
			class="bg-gradient-to-r from-sky-400 to-violet-500 bg-clip-text text-5xl font-extrabold tracking-tight text-transparent sm:text-7xl"
		>
			AgentViz
		</h1>
		<p class="text-xl text-zinc-100 sm:text-2xl">
			Interactive visual tours of AI application development
		</p>
		<p class="max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
			Turn the invisible — API calls, agent loops, and data flows — into
			playable, interactive animations.
		</p>

		<nav
			aria-label="Language switcher"
			class="mt-2 flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900 px-2 py-1 text-xs text-zinc-400"
		>
			<a
				href={`${base}/`}
				hreflang="zh"
				class="rounded-full px-3 py-1 transition-colors hover:text-zinc-100"
			>
				中文
			</a>
			<span aria-hidden="true" class="text-zinc-700">|</span>
			<a
				href={`${base}/en/`}
				hreflang="en"
				aria-current="page"
				class="rounded-full bg-zinc-800 px-3 py-1 font-medium text-zinc-100"
			>
				English
			</a>
		</nav>
	</section>

	<section aria-label="Course map">
		<CourseMap />
	</section>

	<p
		class="mt-12 rounded-xl border border-zinc-800 bg-zinc-900 px-6 py-4 text-center text-sm text-zinc-400"
	>
		🚧 Site under construction — 4 lessons live, more on the way.
	</p>
</Base>
