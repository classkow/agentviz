---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';

type Lesson = CollectionEntry<'lessonsEn'>;
type ModuleKey = Lesson['data']['module'];

const moduleLabels: Record<ModuleKey, string> = {
	E: 'Foundations: talking to an LLM',
	P: 'Prompt engineering',
	T: 'Tool calling',
	R: 'RAG: open-book exams',
	A: 'Agents: models that act',
	G: 'Production engineering'
};

// In-site links must carry the base (/agentviz) prefix.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formatDate = (date: Date) => date.toISOString().slice(0, 10);

const lessons = await getCollection('lessonsEn');
const groups = (Object.keys(moduleLabels) as ModuleKey[])
	.map((key) => ({
		key,
		label: moduleLabels[key],
		items: lessons
			.filter((lesson) => lesson.data.module === key)
			.sort((a, b) => a.data.order - b.data.order)
	}))
	.filter((group) => group.items.length > 0);

// level is optional; a lesson without it drops the fragment.
const levelLabels: Record<NonNullable<Lesson['data']['level']>, string> = {
	intro: 'Intro',
	intermediate: 'Intermediate',
	practice: 'Practice'
};
---

<Base title="Courses" locale="en">
	<h1 class="text-3xl font-bold tracking-tight">Courses</h1>
	<p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
		Every lesson pairs the prose with an interactive demo, and is bound to official
		sources and a review date.
	</p>

	<div class="mt-10 flex flex-col gap-12">
		{
			groups.map((group) => (
				<section aria-labelledby={`module-${group.key}`}>
					<h2
						id={`module-${group.key}`}
						class="text-sm font-semibold tracking-wide text-zinc-400 uppercase"
					>
						Module {group.key} · {group.label}
					</h2>
					<ul class="mt-4 flex flex-col gap-4">
						{group.items.map((lesson: Lesson) => {
							const href = `${base}/en/learn/${lesson.id}/`;
							const { title, description, sources, reviewed_at, draft, readingMinutes, level } =
								lesson.data;
							const meta: string[] = [];
							if (readingMinutes) meta.push(`~${readingMinutes} min`);
							if (level) meta.push(levelLabels[level]);
							meta.push(`Sources ${sources.length}`, `Reviewed on ${formatDate(reviewed_at)}`);
							return (
								<li class="rounded-xl border border-zinc-800 bg-zinc-900/40">
									<a
										href={href}
										class:list={[
											'block p-5 transition-colors',
											draft
												? 'cursor-default text-zinc-500'
												: 'text-zinc-100 hover:bg-zinc-900'
										]}
									>
										<div class="flex flex-wrap items-center gap-3">
											<h3 class="text-lg font-semibold">{title}</h3>
											{draft && (
												<span class="rounded-full border border-zinc-700 px-2 py-0.5 text-xs text-zinc-500">
													Coming soon
												</span>
											)}
											<span
												hidden
												data-read-badge={lesson.id}
												class="rounded-full border border-emerald-400/40 bg-emerald-400/10 px-2 py-0.5 text-xs text-emerald-200"
											>
												✓ Read
											</span>
										</div>
										<p class="mt-2 text-sm leading-relaxed text-zinc-400">
											{description}
										</p>
										<p class="mt-3 text-xs text-zinc-400">{meta.join(' · ')}</p>
									</a>
								</li>
							);
						})}
					</ul>
				</section>
			))
		}
	</div>
</Base>

<script>
	import { initReadProgress } from '../../../lib/read-progress';

	initReadProgress();
</script>
