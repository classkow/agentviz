---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SwimlaneTimeline from '../../../components/SwimlaneTimeline.vue';
import type { TimelineDemo } from '../../../components/SwimlaneTimeline.vue';
import SamplingLab from '../../../components/SamplingLab.vue';
import type { DemoData } from '../../../components/SamplingLab.vue';
import TokenCounter from '../../../components/TokenCounter.vue';
import type { TokenDemo } from '../../../components/TokenCounter.vue';
import QuizBlock from '../../../components/QuizBlock.vue';
import type { QuizData } from '../../../components/QuizBlock.vue';
// One readable-name table site-wide (lesson pages + the references index);
// unmapped hosts fall back to the hostname itself.
import { sourceName } from '../../../lib/source-names';
import { isoDay, reviewStatus } from '../../../lib/review-status';
import { prepareLessonBody } from '../../../lib/lesson-body';

export async function getStaticPaths() {
	const lessons = await getCollection('lessonsEn');
	return lessons.map((lesson) => ({
		params: { slug: lesson.id },
		props: { lesson }
	}));
}

const { lesson } = Astro.props;
const {
	title,
	description,
	module: moduleKey,
	sources,
	reviewed_at: reviewedAt,
	draft,
	demo,
	component,
	readingMinutes,
	level,
	keywords
} = lesson.data;

// Demo island registry: the client:* directive only resolves statically
// imported component identifiers (a registry-variable alias fails with
// NoMatchingImport at build time), so the render site branches on the key and
// references the static imports directly.
const COMPONENTS = {
	swimlane: SwimlaneTimeline,
	sampling: SamplingLab,
	token: TokenCounter
} as const;
type DemoComponentKey = keyof typeof COMPONENTS;
const requestedKey = component ?? 'swimlane';
const demoComponentKey: DemoComponentKey =
	requestedKey in COMPONENTS ? (requestedKey as DemoComponentKey) : 'swimlane';

const moduleNames: Record<typeof moduleKey, string> = {
	E: 'Foundations',
	P: 'Prompt engineering',
	T: 'Tool calling',
	R: 'RAG',
	A: 'Agents',
	G: 'Production engineering'
};

// readingMinutes and level are optional; a missing field drops its fragment.
const levelLabels: Record<NonNullable<typeof level>, string> = {
	intro: 'Intro',
	intermediate: 'Intermediate',
	practice: 'Practice'
};

const reviewedDay = isoDay(reviewedAt);
// The review cadence is resolved at build time: a static site has no clock to read.
const review = reviewStatus(reviewedAt);

// Coined search terms: the browser-side zh index ships no segmentation wasm,
// so multi-char coined words are unfindable (the UI falls back to per-char
// AND). Verified 2026-09-08 by a controlled experiment: injecting the terms
// as space-separated chars via data-pagefind-meta is the only construction
// that reliably matches in the UI. One node per term: a comma after an
// inline `key:value` spec is ambiguous in the documented grammar.
const searchKeywords = keywords ?? [];

const metaParts: string[] = [];
if (readingMinutes) metaParts.push(`~${readingMinutes} min`);
if (level) metaParts.push(levelLabels[level]);
metaParts.push(`Last reviewed: ${reviewedDay}`);

// In-site links must carry the base (/agentviz) prefix.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The quiz island is injected mid-body, so the body is cut from the rendered
// artifact (lesson.rendered.html) into "prose + About the demo data" — which is
// exactly "after the takeaways, before the demo-data note". The same pass
// prepends the base to the in-site links written into the lesson markdown.
const { main: bodyMain, note: bodyNote } = prepareLessonBody(lesson.rendered?.html ?? '', base);

// Demo data loads by the `demo` frontmatter key. The glob sits three levels up
// (this file lives in src/pages/en/learn/ — AGENTS.md pitfall #3). English
// demos live in src/demos/en/; when no English JSON exists the root demos
// folder is the fallback, which is how the e03 lesson reuses the bilingual
// src/demos/e03-sampling.json.
const enDemoModules = import.meta.glob('../../../demos/en/*.json');
const rootDemoModules = import.meta.glob('../../../demos/*.json');
// The three demo components each define their own demo prop type; deserialized
// JSON is unknown, so bridge it to the intersection of all three — an
// intersection assigns to any of the component props.
type AnyDemoData = TimelineDemo & DemoData & TokenDemo;
let demoData: AnyDemoData | null = null;
if (demo) {
	const loadDemo =
		enDemoModules[`../../../demos/en/${demo}.json`] ??
		rootDemoModules[`../../../demos/${demo}.json`];
	if (loadDemo) {
		const mod = (await loadDemo()) as { default: unknown };
		demoData = mod.default as unknown as AnyDemoData;
	}
}

// Quiz JSON resolves the same way as the demo JSON — data-only glob, three
// levels up from src/pages/en/learn/. A lesson without a quiz file renders no quiz.
const quizModules = import.meta.glob('../../../content/quizzes/en/*.json');
const loadQuiz = quizModules[`../../../content/quizzes/en/${lesson.id}.json`];
const quizData: QuizData | null = loadQuiz
	? ((await loadQuiz()) as { default: QuizData }).default
	: null;

// Previous / next lesson inside the same module, ordered by the `order`
// frontmatter key.
const moduleLessons = (await getCollection('lessonsEn'))
	.filter((entry) => entry.data.module === moduleKey)
	.sort((a, b) => a.data.order - b.data.order);
const lessonIndex = moduleLessons.findIndex((entry) => entry.id === lesson.id);
const prevLesson = lessonIndex > 0 ? moduleLessons[lessonIndex - 1] : null;
const nextLesson =
	lessonIndex >= 0 && lessonIndex < moduleLessons.length - 1
		? moduleLessons[lessonIndex + 1]
		: null;
---

<Base title={title} description={description} locale="en">
	<article>
		<nav aria-label="Course index" class="text-sm text-zinc-400">
			<a href={`${base}/en/learn/`} class="hover:text-zinc-100">← All courses</a>
		</nav>

		<header class="mt-6 border-b border-zinc-800 pb-6">
			{
				searchKeywords.map((k) => (
					<span
						data-pagefind-meta={`keywords:${[...k].join(' ')}`}
						class="hidden"
						aria-hidden="true"
					/>
				))
			}
			<div class="flex flex-wrap items-center gap-3">
				<span
					class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold tracking-wide text-zinc-300"
				>
					Module {moduleKey} · {moduleNames[moduleKey]}
				</span>
				{
					draft && (
						<span class="rounded-full border border-zinc-700 px-3 py-1 text-xs text-zinc-500">
							Draft · coming soon
						</span>
					)
				}
			</div>
			<h1 class="mt-4 text-3xl font-bold tracking-tight">{title}</h1>
			<p class="mt-3 text-sm leading-relaxed text-zinc-400">{description}</p>
			<p class="mt-4 text-xs text-zinc-400">
				{metaParts.join(' · ')}
				{review.stale && <span class="ml-2 font-medium text-amber-400">· Review due</span>}
			</p>
		</header>

		{
			demoData && (
				<div id="lesson-demo">
					{demoComponentKey === 'sampling' && <SamplingLab client:visible demo={demoData} ui="en" />}
					{demoComponentKey === 'token' && <TokenCounter client:visible demo={demoData} ui="en" />}
					{demoComponentKey === 'swimlane' && (
						<SwimlaneTimeline client:visible demo={demoData} ui="en" />
					)}
				</div>
			)
		}

		<div class="lesson-body mt-8">
			<div set:html={bodyMain} />
			{quizData && <QuizBlock client:load quiz={quizData} ui="en" />}
			{bodyNote && <div set:html={bodyNote} />}
		</div>

		<footer class="mt-12 border-t border-zinc-800 pt-6">
			<h2 class="text-sm font-semibold tracking-wide text-zinc-400 uppercase">
				Official sources ({sources.length})
				<span class="ml-1 normal-case tracking-normal text-zinc-500">· Verified on {reviewedDay}</span>
			</h2>
			<ul class="mt-3 flex flex-col gap-2">
				{
					sources.map((url) => (
						<li class="break-all text-sm">
							<a
								href={url}
								target="_blank"
								rel="noopener noreferrer"
								class="hover:underline"
							>
								<span class="font-medium text-zinc-100">{sourceName(url)}</span>
								<span class="text-zinc-500"> — </span>
								<span class="font-mono text-xs text-sky-400">{url}</span>
							</a>
						</li>
					))
				}
			</ul>
		</footer>

		<nav
			aria-label="Lesson navigation"
			class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-zinc-800 pt-6 text-sm sm:flex-row sm:gap-6"
		>
			{
				prevLesson ? (
					<a
						href={`${base}/en/learn/${prevLesson.id}/`}
						class="text-sky-400 transition-colors hover:text-sky-300"
					>
						← Previous: {prevLesson.data.title}
					</a>
				) : (
					<span class="text-zinc-500">First lesson in this module</span>
				)
			}
			<span class="shrink-0 text-zinc-400">
				Module {moduleKey} · Lesson {lessonIndex + 1} of {moduleLessons.length}
			</span>
			{
				nextLesson ? (
					<a
						href={`${base}/en/learn/${nextLesson.id}/`}
						class="text-sky-400 transition-colors hover:text-sky-300"
					>
						Next: {nextLesson.data.title} →
					</a>
				) : (
					<span class="text-zinc-500">Last lesson in this module</span>
				)
			}
		</nav>

		<div class="mt-6 flex justify-center">
			<button
				type="button"
				hidden
				aria-pressed="false"
				data-read-toggle={lesson.id}
				data-label-unread="Mark as read"
				data-label-read="✓ Read (click to undo)"
				class="rounded-full border border-zinc-700 bg-zinc-900 px-4 py-1.5 text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100 aria-pressed:border-emerald-400/60 aria-pressed:bg-emerald-400/10 aria-pressed:text-emerald-200"
			></button>
		</div>
	</article>
</Base>

<script>
	import { initReadProgress } from '../../../lib/read-progress';

	initReadProgress();
</script>

<style is:global>
	/* Readable measure for the prose; the demo island sits outside this
	   element and keeps the full column width. */
	.lesson-body {
		max-width: 72ch;
		margin-inline: auto;
	}

	.lesson-body h2 {
		margin-top: 2.5rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-zinc-100, #f4f4f5);
	}

	.lesson-body p {
		margin-top: 0.75rem;
		line-height: 1.75;
		color: var(--color-zinc-300, #d4d4d8);
	}

	.lesson-body blockquote {
		margin-top: 1.5rem;
		border-left: 2px solid #3f3f46;
		padding-left: 1rem;
		color: #a1a1aa;
	}

	.lesson-body ul {
		margin-top: 0.75rem;
		padding-left: 1.25rem;
		list-style: disc;
		line-height: 1.75;
		color: #d4d4d8;
	}

	.lesson-body code {
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		background-color: #27272a;
		font-size: 0.875em;
	}

	/* Tailwind's preflight resets `a` to color:inherit, so the "Back to demo
	   step N" anchors need their own clickable appearance. */
	.lesson-body a {
		color: var(--color-sky-400, #38bdf8);
		text-decoration: none;
	}

	.lesson-body a:hover {
		text-decoration: underline;
	}

	.lesson-body pre {
		margin-top: 1.25rem;
		overflow-x: auto;
		border: 1px solid #27272a;
		border-radius: 0.5rem;
		padding: 1rem;
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	.lesson-body pre code {
		padding: 0;
		background-color: transparent;
	}
</style>
