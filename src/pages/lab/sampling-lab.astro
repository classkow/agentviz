---
import Base from '../../layouts/Base.astro';
import SamplingLab from '../../components/SamplingLab.vue';
import type { DemoData } from '../../components/SamplingLab.vue';
import e03 from '../../demos/e03-sampling.json';

const demo = e03 as unknown as DemoData;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
	title="采样实验室演示"
	description="SamplingLab 教学演示：拖 temperature / top-k / top-p，看下一个 token 的概率分布如何被整形。"
>
	<div class="py-10">
		<a href={`${base}/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
			← 返回首页
		</a>
		<h1 class="mt-4 text-3xl font-bold tracking-tight">采样实验室演示</h1>
		<p class="mt-2 text-sm leading-relaxed text-zinc-400">
			SamplingLab 通用组件：调温度与截断参数看分布怎么被整形，「采样一次」逐枚抽 token，
			「抽 200 次」把实测频率叠在理论概率旁边。候选 logit 与概率均为教学示意。
		</p>
		<SamplingLab client:visible demo={demo} />
	</div>
</Base>
