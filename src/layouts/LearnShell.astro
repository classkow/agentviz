---
// 临时外壳：M0-04 统一切换至 Base 布局（src/layouts/Base.astro），此处仅保证内容路由可用
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = 'AgentViz — 面向 AI 应用开发者的交互式可视化课程。'
} = Astro.props;

// BASE_URL 已含 astro.config 的 base（/agentviz），站内内链必须带此前缀。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="zh-CN" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title ? `${title} · AgentViz` : 'AgentViz'}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-zinc-950 font-sans text-zinc-100 antialiased">
		<header class="border-b border-zinc-800">
			<div class="mx-auto flex h-14 w-full max-w-4xl items-center gap-4 px-6">
				<a href={`${base}/`} class="text-lg font-bold tracking-tight text-zinc-100">
					AgentViz
				</a>
				<a href={`${base}/`} class="text-sm text-zinc-400 hover:text-zinc-100">
					← 返回首页
				</a>
			</div>
		</header>

		<main class="mx-auto w-full max-w-4xl flex-1 px-6 py-10">
			<slot />
		</main>
	</body>
</html>
