---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title?: string;
	description?: string;
	/** Page locale: picks <html lang> and the header nav dictionary. Defaults to the existing zh behavior. */
	locale?: 'zh' | 'en';
	/** Overrides the <html lang> attribute when a page needs a specific BCP-47 tag. */
	lang?: string;
}

const {
	title,
	// The zh default is the long-standing site-wide description (an English
	// sentence); the en locale uses the same sentence, so no behavioral change.
	description = 'AgentViz — interactive visual tours of AI application development.',
	locale = 'zh',
	lang
} = Astro.props;

const htmlLang = lang ?? (locale === 'en' ? 'en' : 'zh-CN');

const pageTitle = title
	? `${title} · AgentViz`
	: 'AgentViz — Interactive visual tours of AI application development';

// BASE_URL has no trailing slash when `base` is configured without one.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconUrl = `${base}/favicon.svg`;

// SEO: absolute canonical URL plus zh/en hreflang alternates.
const siteOrigin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
// Current path with the base prefix removed (always starts with '/').
const raw = Astro.url.pathname.startsWith(base)
	? Astro.url.pathname.slice(base.length) || '/'
	: Astro.url.pathname;
const isEnPage = raw === '/en' || raw.startsWith('/en/');
// zh source path: strip the /en prefix on English pages, otherwise as-is.
const zhPath = isEnPage ? raw.slice(3) || '/' : raw;
// en pages exist at '/', '/learn/…' and '/about/'; anything else points the
// English alternate at the English homepage.
let enPath: string;
if (isEnPage) {
	enPath = raw;
} else if (raw === '/' || raw.startsWith('/learn/') || raw === '/about/') {
	enPath = `/en${raw}`;
} else {
	enPath = '/en/';
}
const withTrailingSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const zhUrl = `${siteOrigin}${base}${withTrailingSlash(zhPath)}`;
const enUrl = `${siteOrigin}${base}${withTrailingSlash(enPath)}`;
---

<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="zh-CN" href={zhUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-zinc-950 font-sans text-zinc-100 antialiased">
		<SiteHeader locale={locale} />
		<main class="mx-auto w-full max-w-6xl flex-1 px-6" data-pagefind-body>
			<slot />
		</main>
		<SiteFooter locale={locale} />
	</body>
</html>
